# PORT: Porta do servidor Express + Vite (padrao 3000)
PORT=3000

# APP_URL: URL publica da aplicacao (usada em links de retorno, OAuth e compartilhamento)
APP_URL="http://localhost:3000"

# DATABASE_PATH: Caminho do arquivo SQLite isolado da previa (separado da producao)
DATABASE_PATH="./data/digmenu_preview.db"

# SESSION_SECRET: Segredo para assinatura adicional de sessoes no servidor
SESSION_SECRET="troque-por-segredo-forte-em-producao"

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: Credenciais OAuth 2.0 do Google (deixe vazio para usar o simulador da previa)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ANNUAL_PLAN_PRICE_CENTS: Valor da assinatura anual em centavos (0 ou vazio = valor em definicao na previa)
ANNUAL_PLAN_PRICE_CENTS=""

# MERCADOPAGO_ACCESS_TOKEN: Token de TESTE do Mercado Pago (ex: TEST-...) - deixe vazio para usar o simulador local
MERCADOPAGO_ACCESS_TOKEN=""

# MERCADOPAGO_WEBHOOK_SECRET: Segredo para validacao HMAC-SHA256 de webhooks do Mercado Pago
MERCADOPAGO_WEBHOOK_SECRET=""

# MERCADOPAGO_PREAPPROVAL_PLAN_ID: ID do plano anual criado no Mercado Pago (opcional)
MERCADOPAGO_PREAPPROVAL_PLAN_ID=""

# MERCADOPAGO_ALLOW_LIVE: Defina "true" apenas se quiser usar token de producao fora de NODE_ENV=production
MERCADOPAGO_ALLOW_LIVE="false"

# ENABLE_SUBSCRIPTION_SIMULATOR: Em producao fica desativado por padrao; defina "true" apenas para testes controlados
ENABLE_SUBSCRIPTION_SIMULATOR=""

# PLATFORM_ADMIN_EMAILS: E-mails autorizados a acessar /admin e gerenciar lojas da plataforma (separados por virgula)
PLATFORM_ADMIN_EMAILS=""
